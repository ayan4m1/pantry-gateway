{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "block-internal": {
        "ClusterId": "identity",
        "Order": -1,
        "Match": { "Path": "/api/{service}/internal/{**rest}" },
        "Metadata": { "Blocked": "true" }
      },
      "identity": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/identity/{**rest}" },
        "Transforms": [ { "PathPattern": "/{**rest}" } ]
      },
      "inventory": {
        "ClusterId": "inventory",
        "Match": { "Path": "/api/inventory/{**rest}" },
        "Transforms": [ { "PathPattern": "/{**rest}" } ]
      },
      "shopping": {
        "ClusterId": "shopping",
        "Match": { "Path": "/api/shopping/{**rest}" },
        "Transforms": [ { "PathPattern": "/{**rest}" } ]
      },
      "notifications": {
        "ClusterId": "notifications",
        "Match": { "Path": "/hubs/notifications/{**rest}" }
      }
    },
    "Clusters": {
      "identity": { "Destinations": { "d1": { "Address": "http://localhost:11385" } } },
      "inventory": { "Destinations": { "d1": { "Address": "http://localhost:11386" } } },
      "shopping": { "Destinations": { "d1": { "Address": "http://localhost:11387" } } },
      "notifications": { "Destinations": { "d1": { "Address": "http://localhost:11388" } } }
    }
  }
}
